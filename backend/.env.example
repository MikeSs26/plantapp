DB_NAME=database_name
DB_USER=which_db
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=port_default_5433
SECRET_KEY=your_secret_key

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email verification (Gmail SMTP). If EMAIL_HOST_USER is empty, emails are
# printed to the console instead of sent (handy for local development).
# EMAIL_HOST_USER is your Gmail address; EMAIL_HOST_PASSWORD is a Google
# "App Password" (16 chars, requires 2-Step Verification enabled), NOT your
# normal Gmail password.
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=PlantApp <youraddress@gmail.com>
# Base URL of the frontend, used to build the verification link in emails.
FRONTEND_URL=http://localhost:5173

# Producción (opcionales en desarrollo):
# DEBUG=False
# ALLOWED_HOSTS=api.tudominio.com
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# FRONTEND_URL=https://plantapp-black.vercel.app