DB_NAME=database_name
DB_USER=which_db
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=port_default_5433
SECRET_KEY=your_secret_key

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email verification.
# RECOMMENDED (works from hosts that block SMTP, like Render): Brevo HTTP API.
# Set BREVO_API_KEY and a Brevo-verified sender in DEFAULT_FROM_EMAIL.
BREVO_API_KEY=your_brevo_api_key
DEFAULT_FROM_EMAIL=PlantApp <youraddress@gmail.com>

# ALTERNATIVE: Gmail SMTP (may be blocked on some hosts). EMAIL_HOST_USER is
# your Gmail; EMAIL_HOST_PASSWORD is a Google "App Password" (16 chars, needs
# 2-Step Verification), NOT your normal password. To try port 465 (SSL) set
# EMAIL_PORT=465. If BREVO_API_KEY is set, it takes priority over SMTP.
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password

# If neither BREVO_API_KEY nor EMAIL_HOST_USER is set, emails print to the
# console (handy for local development — the verification link shows in the log).

# Base URL of the frontend, used to build the verification link in emails.
FRONTEND_URL=http://localhost:5173

# Producción (opcionales en desarrollo):
# DEBUG=False
# ALLOWED_HOSTS=api.tudominio.com
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# FRONTEND_URL=https://plantapp-black.vercel.app